R2_PUBLIC_URL=""

# ------------------------------------------------------------------------------
# MoveCar Worker 与内部 API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_WORKER_URL=http://localhost:8787
WORKER_SECRET=""
CRON_SECRET=""

# ------------------------------------------------------------------------------
# 推送渠道（可选，本地可留空）
# ------------------------------------------------------------------------------
TELEGRAM_MOVECAR_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_MOVECAR_BOT_USERNAME=""
TELEGRAM_WEBHOOK_SECRET=""

# Firebase Web Push public client configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_VAPID_KEY=""

# ------------------------------------------------------------------------------
# 监控（可选）
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Paibao unified gateway: new MoveCar checkouts use these settings.
# Keep legacy merchant settings only while processing existing purchases.
PAY_API_BASE=
PAY_CHECKOUT_CHANNEL=
PAY_WAFFO_API_BASE=
WAFFO_ENV=
WAFFO_PRODUCT_MAP=
WAFFO_TAX_CATEGORY=
PAY_ADMIN_TOKEN=
PAIBAO_FULFILL_HMAC_SECRET=
PAY_CHECKOUT_TIMEOUT_MS=
PAY_RECONCILE_MIN_INTERVAL_MS=
PAY_CHECKOUT_ALLOWED_ORIGINS=
PRICING_ENVIRONMENT=
PAY_FULFILL_URL=
PAY_SUCCESS_URL=
PAY_CANCEL_URL=
# URLs must use HTTPS and the site origin. Fulfill: /api/payment/paibao/fulfill.
# Success/cancel: /payment/order. Checkout origins: a JSON array of URL origins.
# Reconcile interval must be at least the checkout timeout; no default values.
# Checkout channel must be stripe or waffo; there is no automatic fallback.
# PAY_API_BASE is the Stripe gateway base; PAY_WAFFO_API_BASE is the Waffo base.
# Waffo mode must match pricing: PRICING_ENVIRONMENT=live -> WAFFO_ENV=prod;
# PRICING_ENVIRONMENT=test -> WAFFO_ENV=test. Both must be set explicitly.
# WAFFO_PRODUCT_MAP: JSON object mapping pricing_plans.id to reviewed one-time
# Waffo PROD_ + 22-character IDs. Prices remain in pricing_plans, not this map.
# WAFFO_TAX_CATEGORY must match the reviewed product's tax classification.
# Current Waffo order status reconciliation does not independently verify amount;
# these orders wait for signed webhook delivery. Refunds/subscriptions need a
# complete gateway lifecycle contract before they can be enabled.
